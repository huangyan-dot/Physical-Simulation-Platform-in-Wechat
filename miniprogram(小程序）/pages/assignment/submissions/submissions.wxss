/* pages/assignment/submissions/submissions.wxss */
.summary-card {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #3498db;
}

.summary-label {
  font-size: 24rpx;
  color: #7f8c8d;
  margin-top: 8rpx;
}

.sub-card {
  margin-bottom: 20rpx;
}

.sub-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sub-info {
  display: flex;
  flex-direction: column;
}

.sub-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #2c3e50;
}

.sub-no {
  font-size: 24rpx;
  color: #95a5a6;
}

.sub-status {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.sub-status.passed {
  color: #27ae60;
  background: #eafaf1;
}

.sub-status.submitted {
  color: #e67e22;
  background: #fef5e7;
}

.sub-status.not-submitted {
  color: #95a5a6;
  background: #f4f6f7;
}

.sub-detail {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-top: 12rpx;
}
