<!-- pages/experiments/pendulum/pendulum.wxml -->
<view class="experiment-page">
  <!-- 画布区 -->
  <view class="canvas-wrap">
    <canvas
      type="2d"
      id="pendulumCanvas"
      class="pendulum-canvas"
    ></canvas>
    <view class="canvas-hint">T = 2π√(L/g)</view>
  </view>

  <scroll-view class="control-panel" scroll-y enhanced show-scrollbar
    >
    <view class="card params-card">
      <view class="panel-title">实验参数</view>

      <view class="param-item">
        <view class="param-label">
          <text>摆长 L</text>
          <text class="param-value">{{config.length_m}} m</text>
        </view>
        <slider
          min="0.3"
          max="2.0"
          step="0.01"
          value="{{config.length_m}}"
          bindchange="onLengthChange"
          show-value
        />
      </view>

      <view class="param-item">
        <view class="param-label">
          <text>初始角度 θ₀</text>
          <text class="param-value">{{config.angle_deg}}°</text>
        </view>
        <slider
          min="5"
          max="45"
          step="1"
          value="{{config.angle_deg}}"
          bindchange="onAngleChange"
          show-value
        />
      </view>

      <view class="param-item">
        <view class="param-label">
          <text>重力加速度 g</text>
          <text class="param-value">{{config.gravity}} m/s²</text>
        </view>
        <slider
          min="9.6"
          max="10.0"
          step="0.01"
          value="{{config.gravity}}"
          bindchange="onGravityChange"
          show-value
        />
      </view>

      <view class="calc-row">
        <text class="calc-label">理论周期：</text>
        <text class="calc-value">{{periodStr}} s</text>
      </view>
    </view>

    <view class="card">
      <view class="panel-title">读数记录</view>
      <view class="reading-row header">
        <text>摆长(m)</text>
        <text>实测周期(s)</text>
        <text>计算 g</text>
      </view>
      <view class="reading-row">
        <text>{{config.length_m}}</text>
        <input class="reading-input" type="digit" value="{{readings.period}}" data-field="period" bindinput="onReadingInput" />
        <text>{{readings.calc_g}}</text>
      </view>

      <button class="btn btn-primary submit-btn" bindtap="submitReadings" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交读数'}}
      </button>
    </view>
  </scroll-view>
</view>