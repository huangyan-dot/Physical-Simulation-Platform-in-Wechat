/* pages/login/login.wxss */

.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  box-sizing: border-box;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text);
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-light);
  margin-top: 12rpx;
}

.login-body {
  width: 100%;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.login-btn {
  width: 100%;
}

.tips {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.5;
}

.complete-body {
  width: 100%;
}

.form-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
  text-align: center;
}

.form-item {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: var(--text);
  margin-bottom: 12rpx;
}

.input,
.picker {
  height: 88rpx;
  padding: 0 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker {
  display: flex;
  align-items: center;
}

.picker.placeholder {
  color: #999;
}

.submit-btn {
  width: 100%;
  margin-top: 32rpx;
}

/* 模拟登录调试区 */
.mock-area {
  margin-top: 60rpx;
  width: 100%;
}

.mock-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.mock-divider-text {
  font-size: 24rpx;
  color: #ccc;
}

.mock-btn {
  width: 100%;
}

/* 角色选择卡片 */
.role-selector {
  display: flex;
  gap: 16rpx;
  width: 100%;
  margin-bottom: 40rpx;
}

.role-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 12rpx;
  border: 4rpx solid #e0e0e0;
  border-radius: 20rpx;
  background: #fff;
  transition: all 0.2s;
}

.role-card.active {
  border-color: #3498db;
  background: #ebf5fb;
}

.role-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.role-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.role-desc {
  font-size: 24rpx;
  color: #7f8c8d;
}

/* 邀请码输入 */
.invite-area {
  width: 100%;
  margin-bottom: 32rpx;
}

.invite-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 30rpx;
  text-align: center;
  letter-spacing: 4rpx;
  box-sizing: border-box;
}

/* 管理员提示 */
.admin-hint {
  font-size: 26rpx;
  color: #7f8c8d;
  text-align: center;
  padding: 16rpx 0;
}
