/* app.wxss - 全局样式 */
page {
  --primary: #3498db;
  --primary-dark: #2980b9;
  --success: #2ecc71;
  --warning: #f39c12;
  --danger: #e74c3c;
  --text: #2c3e50;
  --text-light: #7f8c8d;
  --bg: #f5f6fa;
  --card-bg: #ffffff;
  --border: #e1e8ed;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  background-color: var(--bg);
  line-height: 1.6;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  transition: opacity 0.2s;
}

.btn:active {
  opacity: 0.8;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
}

.btn-success {
  background: var(--success);
  color: #fff;
}

.btn-danger {
  background: var(--danger);
  color: #fff;
}

.btn-outline {
  background: transparent;
  border: 2rpx solid var(--primary);
  color: var(--primary);
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-light);
  margin-bottom: 24rpx;
}

.text-center {
  text-align: center;
}

.flex {
  display: flex;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }

/* ===== 矩阵/工作表动效（高斯消去/LU/追赶/平方根等页共用） ===== */
.matrix-cell, .ws-cell {
  transition: background-color 0.25s ease, color 0.25s ease, opacity 0.3s ease, border-color 0.25s ease;
}

/* 新算出的数值：琥珀色弹入一拍 */
@keyframes matrixCellPop {
  0% { transform: scale(1.35); color: var(--warning); }
  100% { transform: scale(1); }
}
.matrix-cell.cell-new, .ws-cell.cell-new {
  animation: matrixCellPop 0.38s ease-out;
}

/* 刚被消成 0：翻红后淡入灰色 */
@keyframes matrixZeroOut {
  0% { opacity: 1; transform: scale(1.2); color: var(--danger); }
  100% { opacity: 0.45; transform: scale(1); }
}
.matrix-cell.cell-zero-new, .ws-cell.cell-zero-new {
  animation: matrixZeroOut 0.45s ease-out;
}

/* 本拍主元行：整行琥珀辉光 */
.matrix-row.row-pivot .matrix-cell {
  background: rgba(243, 156, 18, 0.1);
  box-shadow: inset 0 0 0 2rpx rgba(243, 156, 18, 0.75);
}

/* 候选主元推荐行：绿色呼吸边框 */
@keyframes candBreathe {
  0%, 100% { border-color: rgba(46, 204, 113, 0.45); }
  50% { border-color: rgba(46, 204, 113, 1); }
}
.cand-row { transition: border-color 0.2s ease, background-color 0.2s ease; }
.cand-row.cand-max { animation: candBreathe 1.6s ease-in-out infinite; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: var(--text-light);
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}
