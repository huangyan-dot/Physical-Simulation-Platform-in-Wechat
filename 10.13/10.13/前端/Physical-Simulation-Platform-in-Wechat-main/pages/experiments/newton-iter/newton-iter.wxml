<!-- pages/experiments/newton-iter/newton-iter.wxml -->
<view class="experiment-page">
  <!-- 函数图像区 -->
  <view class="canvas-wrap" style="height:{{canvasHeight}}px;">
    <canvas
      type="2d"
      id="plotCanvas"
      class="plot-canvas {{fullscreen ? 'canvas-hidden' : ''}}"
      style="width:{{canvasWidth}}px;height:{{canvasHeight}}px;"
      bindtouchstart="onPlotTouchStart"
      catchtouchmove="onPlotTouchMove"
      bindtouchend="onPlotTouchEnd"
      bindtouchcancel="onPlotTouchEnd"
    ></canvas>
  </view>

  <!-- 图像工具条（放在画布外部，避免被原生 canvas 遮挡） -->
  <view class="graph-toolbar">
    <view class="tool-btn" bindtap="enterFullscreen">⛶ 全屏</view>
    <view class="tool-btn" bindtap="zoomBy" data-factor="1.3">＋</view>
    <view class="tool-btn" bindtap="zoomBy" data-factor="0.77">－</view>
    <view class="tool-btn" bindtap="resetView">⟲</view>
    <text class="tool-hint">从 x₀ 出发切线迭代</text>
  </view>

  <scroll-view class="control-panel" scroll-y enhanced show-scrollbar>
    <!-- 教师/管理员预览提示 -->
    <view class="preview-banner" wx:if="{{isPreview}}">预览模式：可自由体验实验，提交成绩仅对学生开放</view>

    <!-- 实验参数 -->
    <view class="card params-card">
      <view class="panel-title">实验参数</view>

      <picker range="{{funcLabels}}" value="{{funcIndex}}" bindchange="onFuncChange">
        <view class="param-row">
          <text>被测函数</text>
          <text class="param-value">{{funcLabels[funcIndex]}} ▾</text>
        </view>
      </picker>

      <view class="param-row">
        <text>迭代初值 x₀</text>
        <input
          class="x0-input"
          type="digit"
          value="{{x0Text}}"
          bindinput="onX0Input"
          bindconfirm="restartFromX0"
        />
      </view>
      <view class="param-row">
        <text>最大迭代步数</text>
        <input
          class="x0-input"
          type="number"
          value="{{maxStepsText}}"
          placeholder="默认 {{stepLimit}}"
          bindinput="onMaxStepsInput"
          bindconfirm="restartFromX0"
        />
      </view>
      <view class="param-hint">可设 0 ~ {{stepLimit}} 的整数（本题上限按该函数的收敛特性而定），留空为默认；设为 0 表示不迭代，直接取 x₀。改完点「从 x₀ 重来」生效</view>
      <view class="param-row">
        <text>收敛容差</text>
        <text class="param-value">{{tolText}}</text>
      </view>
      <view class="param-row">
        <text>当前步数上限</text>
        <text class="param-value">{{maxSteps}}{{stepsCustom ? ' (自定义)' : ' (默认)'}}</text>
      </view>
      <view class="param-row">
        <text>参考迭代数</text>
        <text class="param-value">{{config.expected_iterations}}</text>
      </view>
    </view>

    <!-- 迭代操作 -->
    <view class="card step-card">
      <view class="panel-title">迭代操作（已 {{iterations}} 步）</view>

      <view class="kv-row"><text>当前点 xₙ</text><text>{{fmtXn}}</text></view>
      <view class="kv-row"><text>f(xₙ)</text><text>{{fmtFx}}</text></view>
      <view class="kv-row"><text>步长 |xₙ₊₁−xₙ|</text><text>{{fmtDx}}</text></view>

      <view class="btn-row">
        <button class="btn btn-primary step-btn" bindtap="step" disabled="{{autoPlaying || converged}}">迭代一步</button>
      </view>
      <view class="btn-row">
        <button class="btn btn-outline mini-btn" bindtap="restartFromX0">从 x₀ 重来</button>
        <button class="btn btn-outline mini-btn" bindtap="autoRun" disabled="{{!autoPlaying && converged}}">{{autoPlaying ? '■ 停止演示' : '自动迭代'}}</button>
      </view>
    </view>

    <!-- 迭代记录 -->
    <view class="card history-card">
      <view class="panel-title">迭代记录</view>

      <view class="iter-row header">
        <text>n</text><text>xₙ</text><text>f(xₙ)</text><text>|Δx|</text>
      </view>
      <view wx:for="{{history}}" wx:key="n" class="iter-row">
        <text>{{item.n}}</text><text>{{item.x}}</text><text>{{item.fx}}</text><text>{{item.dx}}</text>
      </view>
      <view wx:if="{{history.length === 0}}" class="empty-iter">尚未开始迭代，点击「迭代一步」</view>
    </view>

    <!-- 求解结果与提交 -->
    <view class="card result-card" wx:if="{{converged}}">
      <view class="panel-title">求解结果</view>
      <view class="kv-row"><text>求得根</text><text class="root-value">{{rootText}}</text></view>
      <view class="kv-row"><text>迭代次数</text><text>{{iterations}}（参考 {{config.expected_iterations}}）</text></view>
      <view class="penalty-tip" wx:if="{{overExpected}}">迭代次数超出参考值较多，按规则将扣迭代效率分</view>
      <button wx:if="{{!isPreview}}" class="btn btn-primary submit-btn" bindtap="submitReadings" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交成绩'}}
      </button>
    </view>
  </scroll-view>
</view>

<!-- 全屏图像（点击画布或⛶进入；按钮缩放 / 单指拖动 / 双击复位） -->
<view class="fullscreen-mask" wx:if="{{fullscreen}}">
  <view class="full-bar full-top">
    <text class="full-title">{{funcLabel}}</text>
    <view class="full-btn close" bindtap="exitFullscreen">✕ 关闭</view>
  </view>
  <canvas
    type="2d"
    id="fullCanvas"
    class="full-canvas"
    style="width:{{fullW}}px;height:{{fullCanvasH}}px;"
    bindtouchstart="onPlotTouchStart"
    catchtouchmove="onPlotTouchMove"
    bindtouchend="onPlotTouchEnd"
    bindtouchcancel="onPlotTouchEnd"
  ></canvas>
  <view class="full-bar full-bottom">
    <view class="full-btn" bindtap="zoomBy" data-factor="1.3">＋ 放大</view>
    <view class="full-btn" bindtap="zoomBy" data-factor="0.77">－ 缩小</view>
    <view class="full-btn" bindtap="resetView">⟲ 复位</view>
    <text class="full-tips">拖动可平移 · 双击图像退出</text>
  </view>
</view>
