<!-- pages/experiments/least-squares-fit/least-squares-fit.wxml - 最小二乘拟合（数值分析 L24） -->
<view class="experiment-page">
  <!-- 图像区：蓝散点观测数据、橙实线拟合曲线（参考）、绿虚线 x_eval 与拟合点 -->
  <view class="canvas-wrap" style="height:{{canvasHeight}}px;">
    <canvas
      type="2d"
      id="plotCanvas"
      class="plot-canvas {{fullscreen ? 'canvas-hidden' : ''}}"
      style="width:{{canvasWidth}}px;height:{{canvasHeight}}px;"
      bindtouchstart="onPlotTouchStart"
      catchtouchmove="onPlotTouchMove"
      bindtouchend="onPlotTouchEnd"
      bindtouchcancel="onPlotTouchEnd"
    ></canvas>
  </view>

  <!-- 图像工具条（放在画布外部，避免被原生 canvas 遮挡） -->
  <view class="graph-toolbar">
    <view class="tool-btn" bindtap="enterFullscreen">⛶ 全屏</view>
    <view class="tool-btn" bindtap="zoomBy" data-factor="1.3">＋</view>
    <view class="tool-btn" bindtap="zoomBy" data-factor="0.77">－</view>
    <view class="tool-btn" bindtap="resetView">⟲</view>
    <text class="tool-hint">残差平方和最小的拟合不过点</text>
  </view>

  <scroll-view class="control-panel" scroll-y enhanced show-scrollbar>
    <!-- 教师/管理员预览提示 -->
    <view class="preview-banner" wx:if="{{isPreview}}">预览模式：可自由体验实验，提交成绩仅对学生开放</view>

    <!-- 实验参数 -->
    <view class="card params-card">
      <view class="panel-title">实验参数</view>

      <picker range="{{problemLabels}}" value="{{problemIndex}}" bindchange="onProblemChange">
        <view class="param-row">
          <text>拟合题</text>
          <text class="param-value">{{problemLabels[problemIndex]}} ▾</text>
        </view>
      </picker>

      <picker range="{{mOptions}}" value="{{mIndex}}" bindchange="onMChange">
        <view class="param-row">
          <text>拟合次数 m</text>
          <text class="param-value">{{mOptions[mIndex]}} ▾</text>
        </view>
      </picker>

      <view class="param-row">
        <text>求值点 x_eval</text>
        <input class="num-input" type="digit" value="{{xEvalText}}" bindinput="onXEvalInput" bindconfirm="applyXEvalInput" />
      </view>
      <view class="param-hint">{{config.method_hint}}；换题后 m、x_eval 回落新题库内默认值</view>
      <view class="btn-row apply-row">
        <button class="btn btn-primary mini-btn" bindtap="applyXEvalInput">应用求值点（重开表格）</button>
      </view>

      <view class="param-row">
        <text>数据点数</text>
        <text class="param-value">{{ptsLabel}} 组</text>
      </view>
      <view class="param-row">
        <text>题目说明</text>
      </view>
      <view class="param-hint">{{problemDesc}}</view>
    </view>

    <!-- 求和表（各格乘积已算好，Σ 行留给你手算） -->
    <view class="card basis-card">
      <view class="panel-title">求和表（Σ 行留给你）</view>
      <view class="card-note" wx:if="{{isExp}}">ln 线性化：Yₖ=ln yₖ 已算好（对数域拟合 A+Bx，最后 ŷ(x_eval)=e^{c₀+c₁·x_eval} 回原域）</view>
      <view class="card-note" wx:else>残差平方和 J(c)=Σ(yₖ−P(xₖ))² 最小 → 对 c_i 求偏导置零即得法方程</view>
      <view class="sum-table">
        <view class="sum-row sum-head">
          <view class="sum-cell" wx:for="{{sumHeaders}}" wx:key="*this">{{item}}</view>
        </view>
        <view class="sum-row" wx:for="{{sumRows}}" wx:key="key" wx:for-item="row">
          <view class="sum-cell" wx:for="{{row.cells}}" wx:key="*this" wx:for-index="ci">{{item}}</view>
        </view>
        <view class="sum-row sum-tail">
          <view class="sum-cell">Σ</view>
          <view class="sum-cell" wx:for="{{sumTailCells}}">?</view>
        </view>
      </view>
      <view class="card-note">把每列相加得到 n、Σx、Σx²、Σxy……（这正是法方程要用的系数与右端项）</view>
    </view>

    <!-- 法方程分步卡（结构给出、求解留给你） -->
    <view class="card basis-card">
      <view class="panel-title">法方程（高斯消去解 c₀..c_m 留给你）</view>
      <view wx:for="{{normRows}}" wx:key="key" class="basis-row">
        <view class="basis-formula">{{item.formula}}</view>
        <view class="basis-line"><text class="basis-tag">代入</text><text>{{item.substituted}}</text></view>
      </view>
      <view class="card-note">m=点数−1 时法方程解=插值多项式（穿过所有点）——本关限 m ≤ 点数−2，拟合才是"靠近但不过点"；解出 c 后求 P(x_eval)</view>
      <view class="coef-inputs">
        <view class="basis-input-row" wx:for="{{coefRows}}" wx:key="key">
          <text class="basis-input-label">{{item.label}} =</text>
          <input
            class="num-input basis-input"
            type="digit"
            value="{{item.input}}"
            placeholder="选填"
            bindinput="onCoefInput"
            data-index="{{index}}"
          />
        </view>
      </view>
      <view class="card-note">系数选填：填全会随提交记录进教师端审计日志（不参与打分），要么全填要么全空</view>
    </view>

    <!-- 最终答案与提交 -->
    <view class="card result-card">
      <view class="panel-title">你的拟合值 {{isExp ? 'ŷ(x_eval)' : 'P(x_eval)'}}</view>
      <view class="param-row answer-row">
        <text>x_eval = {{xEvalLabel}}，值 =</text>
        <input
          class="num-input"
          type="digit"
          value="{{valueText}}"
          placeholder="填计算结果"
          bindinput="onValueInput"
        />
      </view>
      <view class="card-note">真值由后端按同一数据点、同一 m 现算法方程——认真求和、消去、代回即满分。拟合不过点：抄观测值约 29/30 分、抄均值 16 分均不过线；二次题抄观测 44 分、抄真函数 x²=4 恰 58 分差线 2 分、次数用错 1 分；指数题不线性化直接拟 y 约 12 分不过线；抄三次插值 4.4375 约 69 分能过线但非满分（插值≠拟合，过程真伪由系数审计暴露）</view>
      <button wx:if="{{!isPreview}}" class="btn btn-primary submit-btn" bindtap="submitReadings" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交成绩'}}
      </button>
    </view>
  </scroll-view>
</view>

<!-- 全屏图像（点击画布或⛶进入；按钮缩放 / 单指拖动 / 双击复位） -->
<view class="fullscreen-mask" wx:if="{{fullscreen}}">
  <view class="full-bar full-top">
    <text class="full-title">{{problemLabel}} · 最小二乘拟合</text>
    <view class="full-btn close" bindtap="exitFullscreen">✕ 关闭</view>
  </view>
  <canvas
    type="2d"
    id="fullCanvas"
    class="full-canvas"
    style="width:{{fullW}}px;height:{{fullCanvasH}}px;"
    bindtouchstart="onPlotTouchStart"
    catchtouchmove="onPlotTouchMove"
    bindtouchend="onPlotTouchEnd"
    bindtouchcancel="onPlotTouchEnd"
  ></canvas>
  <view class="full-bar full-bottom">
    <view class="full-btn" bindtap="zoomBy" data-factor="1.3">＋ 放大</view>
    <view class="full-btn" bindtap="zoomBy" data-factor="0.77">－ 缩小</view>
    <view class="full-btn" bindtap="resetView">⟲ 复位</view>
    <text class="full-tips">拖动可平移 · 双击图像退出</text>
  </view>
</view>
