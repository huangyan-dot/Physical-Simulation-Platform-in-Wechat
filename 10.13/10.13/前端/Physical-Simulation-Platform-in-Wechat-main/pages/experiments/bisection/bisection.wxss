/* pages/experiments/bisection/bisection.wxss */

.experiment-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

.canvas-wrap {
  position: relative;
  flex-shrink: 0;
  background: #000;
}

.plot-canvas {
  display: block;
}

/* 全屏时隐藏页内画布：canvas 是原生组件，会穿透全屏遮罩 */
.canvas-hidden {
  display: none;
}

/* 图像工具条：全屏 / 放大 / 缩小 / 复位 */
.graph-toolbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  background: #0c1424;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.tool-btn {
  min-width: 64rpx;
  padding: 8rpx 18rpx;
  text-align: center;
  border-radius: 10rpx;
  background: rgba(52, 152, 219, 0.18);
  border: 1rpx solid rgba(52, 152, 219, 0.45);
  color: #7ec8f5;
  font-size: 26rpx;
}

.tool-btn:active {
  background: rgba(52, 152, 219, 0.34);
}

.tool-hint {
  margin-left: auto;
  color: rgba(255, 255, 255, 0.45);
  font-size: 22rpx;
}

/* 全屏图像遮罩：上栏 + 画布 + 下栏，控件不压在 canvas 上 */
.fullscreen-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  flex-direction: column;
  background: #10182a;
}

.full-canvas {
  display: block;
  flex-shrink: 0;
}

.full-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #0c1424;
}

.full-top {
  height: 44px;
}

.full-bottom {
  height: 72px;
}

.full-title {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
}

.full-btn {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  font-size: 28rpx;
}

.full-btn:active {
  background: rgba(255, 255, 255, 0.24);
}

.full-btn.close {
  margin-left: auto;
  background: rgba(231, 76, 60, 0.24);
}

.full-tips {
  margin-left: auto;
  color: rgba(255, 255, 255, 0.4);
  font-size: 22rpx;
}

/* 参数说明小字（自定义步数范围提示） */
.param-hint {
  margin: -4rpx 0 12rpx;
  color: rgba(255, 255, 255, 0.45);
  font-size: 22rpx;
  line-height: 1.5;
}

.control-panel {
  flex: 1;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.preview-banner {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(52, 152, 219, 0.08);
  border: 1rpx solid rgba(52, 152, 219, 0.35);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--primary);
}

.params-card,
.step-card,
.history-card,
.result-card {
  margin-bottom: 20rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.param-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--border);
}

.param-row:last-child {
  border-bottom: none;
}

.param-value {
  color: var(--primary);
  font-weight: 500;
}

/* 区间输入框 */
.num-input {
  text-align: right;
  color: var(--primary);
  font-weight: 500;
  font-family: Consolas, Menlo, monospace;
}

.interval-apply-row {
  margin-top: 8rpx;
}

.kv-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: var(--text-light);
}

.kv-row text:last-child {
  color: var(--text);
  font-weight: 500;
  font-family: Consolas, Menlo, monospace;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.half-btn {
  flex: 1;
  font-size: 26rpx;
  height: 80rpx;
}

.mini-btn {
  flex: 1;
  font-size: 26rpx;
  height: 76rpx;
}

.iter-row {
  display: flex;
  padding: 10rpx 0;
  font-size: 24rpx;
  border-bottom: 1rpx solid var(--border);
  font-family: Consolas, Menlo, monospace;
}

.iter-row.header {
  color: var(--text-light);
  font-weight: 600;
  font-family: inherit;
}

.iter-row text {
  flex: 1;
  text-align: right;
  overflow: hidden;
  white-space: nowrap;
}

.iter-row text:first-child {
  flex: 0.4;
  text-align: left;
}

.empty-iter {
  padding: 24rpx 0;
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
}

.root-value {
  color: var(--success);
  font-weight: 600;
}

.submit-btn {
  margin-top: 16rpx;
}
