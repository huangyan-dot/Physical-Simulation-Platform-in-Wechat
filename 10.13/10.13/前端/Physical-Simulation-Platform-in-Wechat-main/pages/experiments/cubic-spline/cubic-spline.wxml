<!-- pages/experiments/cubic-spline/cubic-spline.wxml - 三次样条插值（数值分析 L25） -->
<view class="experiment-page">
  <!-- 函数图像区：蓝实线 f(x)、橙实线 S(x)、灰虚线 P(x) 对照、节点散点、绿虚线 x_eval -->
  <view class="canvas-wrap" style="height:{{canvasHeight}}px;">
    <canvas
      type="2d"
      id="plotCanvas"
      class="plot-canvas {{fullscreen ? 'canvas-hidden' : ''}}"
      style="width:{{canvasWidth}}px;height:{{canvasHeight}}px;"
      bindtouchstart="onPlotTouchStart"
      catchtouchmove="onPlotTouchMove"
      bindtouchend="onPlotTouchEnd"
      bindtouchcancel="onPlotTouchEnd"
    ></canvas>
  </view>

  <!-- 图像工具条（放在画布外部，避免被原生 canvas 遮挡） -->
  <view class="graph-toolbar">
    <view class="tool-btn" bindtap="enterFullscreen">⛶ 全屏</view>
    <view class="tool-btn" bindtap="zoomBy" data-factor="1.3">＋</view>
    <view class="tool-btn" bindtap="zoomBy" data-factor="0.77">－</view>
    <view class="tool-btn" bindtap="resetView">⟲</view>
    <text class="tool-hint">龙格题上灰虚线 P 振荡、橙实线 S 光滑</text>
  </view>

  <scroll-view class="control-panel" scroll-y enhanced show-scrollbar>
    <!-- 教师/管理员预览提示 -->
    <view class="preview-banner" wx:if="{{isPreview}}">预览模式：可自由体验实验，提交成绩仅对学生开放</view>

    <!-- 实验参数 -->
    <view class="card params-card">
      <view class="panel-title">实验参数</view>

      <picker range="{{problemLabels}}" value="{{problemIndex}}" bindchange="onProblemChange">
        <view class="param-row">
          <text>样条题</text>
          <text class="param-value">{{problemLabels[problemIndex]}} ▾</text>
        </view>
      </picker>

      <view class="param-row">
        <text>求值点 x_eval</text>
        <input
          class="num-input"
          type="digit"
          value="{{xEvalText}}"
          bindinput="onXEvalInput"
          bindconfirm="applyXEvalInput"
        />
      </view>
      <view class="param-hint">{{config.x_eval_hint}}；样条不外推，x_eval 须在节点区间 [x_0, x_{{nodeRows.length - 1}}] 内</view>
      <view class="btn-row apply-row">
        <button class="btn btn-primary mini-btn" bindtap="applyXEvalInput">应用求值点（重排三弯矩方程）</button>
      </view>

      <view class="param-row">
        <text>原函数（仅对照）</text>
        <text class="param-value">{{fLabel}}</text>
      </view>
      <view class="param-row">
        <text>节点数 n</text>
        <text class="param-value">{{nodeRows.length}}</text>
      </view>
      <view class="param-hint">{{problemDesc}}</view>
    </view>

    <!-- 插值表 -->
    <view class="card table-card">
      <view class="panel-title">插值表（含区间宽 h_i = x_{i+1} − x_i）</view>
      <view class="table-row header">
        <text>i</text><text>x_i</text><text>y_i</text><text>h_i</text>
      </view>
      <view wx:for="{{nodeRows}}" wx:key="i" class="table-row">
        <text>{{item.i}}</text><text>{{item.x}}</text><text>{{item.y}}</text><text>{{item.h}}</text>
      </view>
      <view class="card-note">自然边界：S''(x_0)=S''(x_{n-1})=0，即两端弯矩 M_0=M_{n-1}=0，内点共 n−2 个未知量</view>
    </view>

    <!-- 三弯矩方程分步卡 -->
    <view class="card basis-card">
      <view class="panel-title">三弯矩方程（自然边界）</view>
      <view class="card-note">μ_i = h_i/(h_i+h_{i+1})，λ_i = 1−μ_i，d_i = 6·[(y_{i+1}−y_i)/h_{i+1} − (y_i−y_{i−1})/h_i]/(h_i+h_{i+1})；逐个代入后用追赶法解出各 M_i——这就是三次样条的「手工部分」</view>

      <view wx:for="{{momentRows}}" wx:key="i" class="basis-row">
        <view class="basis-formula">{{item.formula}}</view>
        <view class="basis-line"><text class="basis-tag">代入</text><text>{{item.substituted}}</text></view>
      </view>
    </view>

    <!-- 弯矩列填写卡 -->
    <view class="card basis-card">
      <view class="panel-title">弯矩列 M_0..M_{{nodeRows.length - 1}}</view>
      <view class="basis-row" wx:for="{{mRows}}" wx:key="i">
        <view class="basis-input-row">
          <text class="basis-input-label">M{{item.i}} =</text>
          <text wx:if="{{item.fixed}}" class="m-fixed">{{item.text}}</text>
          <input
            wx:else
            class="num-input basis-input"
            type="digit"
            value="{{item.text}}"
            placeholder="选填"
            bindinput="onMInput"
            data-index="{{index}}"
          />
        </view>
      </view>
      <view class="card-note">弯矩 M 选填：填了将随提交记录进教师端审计日志（不参与打分），内点要么全填要么全空；解三弯矩方程建议用追赶法</view>
    </view>

    <!-- 段上求值与提交 -->
    <view class="card result-card">
      <view class="panel-title">段上求值</view>
      <view class="sum-line" wx:for="{{segmentLines}}" wx:key="index">{{item}}</view>
      <view class="card-note">把你自己解出的 M_k、M_{k+1} 代入段公式手算 S(x_eval)——切忌直接抄图像上样条点或原函数值，误差带会惩罚</view>

      <view class="param-row answer-row">
        <text>你算出的 S(x_eval)</text>
        <input
          class="num-input"
          type="digit"
          value="{{valueText}}"
          placeholder="填计算结果"
          bindinput="onValueInput"
        />
      </view>
      <button wx:if="{{!isPreview}}" class="btn btn-primary submit-btn" bindtap="submitReadings" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交成绩'}}
      </button>
    </view>
  </scroll-view>
</view>

<!-- 全屏图像（点击画布或⛶进入；按钮缩放 / 单指拖动 / 双击复位） -->
<view class="fullscreen-mask" wx:if="{{fullscreen}}">
  <view class="full-bar full-top">
    <text class="full-title">{{problemLabel}} · 三次样条插值</text>
    <view class="full-btn close" bindtap="exitFullscreen">✕ 关闭</view>
  </view>
  <canvas
    type="2d"
    id="fullCanvas"
    class="full-canvas"
    style="width:{{fullW}}px;height:{{fullCanvasH}}px;"
    bindtouchstart="onPlotTouchStart"
    catchtouchmove="onPlotTouchMove"
    bindtouchend="onPlotTouchEnd"
    bindtouchcancel="onPlotTouchEnd"
  ></canvas>
  <view class="full-bar full-bottom">
    <view class="full-btn" bindtap="zoomBy" data-factor="1.3">＋ 放大</view>
    <view class="full-btn" bindtap="zoomBy" data-factor="0.77">－ 缩小</view>
    <view class="full-btn" bindtap="resetView">⟲ 复位</view>
    <text class="full-tips">拖动可平移 · 双击图像退出</text>
  </view>
</view>
