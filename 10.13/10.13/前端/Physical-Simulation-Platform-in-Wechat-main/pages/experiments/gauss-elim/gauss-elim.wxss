/* pages/experiments/gauss-elim/gauss-elim.wxss - 高斯消去法（数值分析 L13）
   版式沿用 bisection 页卡片布局；矩阵/主元选择为本页特有。 */

.experiment-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

.control-panel {
  flex: 1;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.preview-banner {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(52, 152, 219, 0.08);
  border: 1rpx solid rgba(52, 152, 219, 0.35);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--primary);
}

.params-card,
.step-card,
.history-card,
.result-card {
  margin-bottom: 20rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.param-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--border);
}

.param-row:last-child {
  border-bottom: none;
}

.param-value {
  color: var(--primary);
  font-weight: 500;
}

.param-hint {
  margin: 8rpx 0 12rpx;
  color: var(--text-light);
  font-size: 22rpx;
  line-height: 1.5;
}

.param-hint.warn {
  color: var(--warning);
}

/* 原方程组（等宽字体对齐竖式观感） */
.eq-line {
  padding: 8rpx 0;
  font-family: Consolas, Menlo, monospace;
  font-size: 28rpx;
}

/* 增广矩阵网格：行标 + n+1 列，b 列以左分隔线区隔 */
.matrix-row {
  display: flex;
  align-items: stretch;
}

.row-label {
  width: 64rpx;
  flex-shrink: 0;
  color: var(--text-light);
  font-size: 22rpx;
  font-family: Consolas, Menlo, monospace;
  display: flex;
  align-items: center;
}

.matrix-cell {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-family: Consolas, Menlo, monospace;
  font-size: 26rpx;
  border-bottom: 1rpx solid var(--border);
  box-sizing: border-box;
}

.matrix-row:last-child .matrix-cell {
  border-bottom: none;
}

.matrix-cell.cell-b {
  border-left: 2rpx solid var(--primary);
  color: var(--primary);
}

/* 当前主元列（候选行内）高亮 */
.matrix-cell.cell-pc {
  background: rgba(52, 152, 219, 0.12);
  color: var(--primary);
  font-weight: 600;
}

/* 已消元完成的行（主元行）置灰 */
.matrix-row.done-row .matrix-cell {
  color: var(--text-light);
}

.matrix-row.done-row .matrix-cell.cell-b {
  color: var(--text-light);
}

/* 候选主元行（点选） */
.cand-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  margin: 8rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid var(--border);
  font-family: Consolas, Menlo, monospace;
  font-size: 26rpx;
}

.cand-row:active {
  background: rgba(52, 152, 219, 0.16);
}

.cand-row.cand-max {
  border-color: rgba(46, 204, 113, 0.55);
}

.cand-label {
  min-width: 56rpx;
  font-weight: 600;
}

.cand-abs {
  color: var(--text-light);
}

.cand-tag {
  margin-left: auto;
  color: var(--success);
  font-size: 22rpx;
  font-family: inherit;
}

/* 回代公式行 */
.back-line {
  padding: 12rpx 0;
  font-family: Consolas, Menlo, monospace;
  font-size: 26rpx;
  border-bottom: 1rpx solid var(--border);
}

.back-line:last-of-type {
  border-bottom: none;
}

.empty-iter {
  padding: 24rpx 0;
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
}

/* 消元记录 */
.step-log {
  padding: 10rpx 0;
  font-size: 24rpx;
  color: var(--text-light);
  border-bottom: 1rpx solid var(--border);
  font-family: Consolas, Menlo, monospace;
  line-height: 1.5;
}

.step-log:last-child {
  border-bottom: none;
}

/* 解向量输入行 */
.sol-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.sol-row:last-of-type {
  border-bottom: none;
}

.sol-label {
  width: 96rpx;
  flex-shrink: 0;
  font-family: Consolas, Menlo, monospace;
  font-size: 28rpx;
}

.num-input {
  flex: 1;
  text-align: right;
  color: var(--primary);
  font-weight: 500;
  font-family: Consolas, Menlo, monospace;
}

.kv-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: var(--text-light);
}

.kv-row text:last-child {
  color: var(--text);
  font-weight: 500;
  font-family: Consolas, Menlo, monospace;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.half-btn {
  flex: 1;
  font-size: 26rpx;
  height: 80rpx;
}

.mini-btn {
  flex: 1;
  font-size: 26rpx;
  height: 76rpx;
}

.root-value {
  color: var(--success);
  font-weight: 600;
}

.submit-btn {
  margin-top: 16rpx;
}

/* 顶部固定图像区（直接作用于自定义组件宿主节点；不随 control-panel 滚动，排版同二分/牛顿页） */
.iter-graph {
  display: block;
  width: 100%;
  flex-shrink: 0;
}
