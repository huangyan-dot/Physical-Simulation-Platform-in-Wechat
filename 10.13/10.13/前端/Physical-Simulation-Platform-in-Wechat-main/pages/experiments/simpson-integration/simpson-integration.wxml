<!-- pages/experiments/simpson-integration/simpson-integration.wxml - 复合辛普森积分法（数值分析 L17） -->
<view class="experiment-page">
  <!-- 函数图像区：蓝实线 f(x)、橙虚线辛普森抛物线、积分区域阴影、绿虚线 a/b -->
  <view class="canvas-wrap" style="height:{{canvasHeight}}px;">
    <canvas
      type="2d"
      id="plotCanvas"
      class="plot-canvas {{fullscreen ? 'canvas-hidden' : ''}}"
      style="width:{{canvasWidth}}px;height:{{canvasHeight}}px;"
      bindtouchstart="onPlotTouchStart"
      catchtouchmove="onPlotTouchMove"
      bindtouchend="onPlotTouchEnd"
      bindtouchcancel="onPlotTouchEnd"
    ></canvas>
  </view>

  <!-- 图像工具条（放在画布外部，避免被原生 canvas 遮挡） -->
  <view class="graph-toolbar">
    <view class="tool-btn" bindtap="enterFullscreen">⛶ 全屏</view>
    <view class="tool-btn" bindtap="zoomBy" data-factor="1.3">＋</view>
    <view class="tool-btn" bindtap="zoomBy" data-factor="0.77">－</view>
    <view class="tool-btn" bindtap="resetView">⟲</view>
    <text class="tool-hint">抛物线与 x 轴围成的面积即 S_n</text>
  </view>

  <scroll-view class="control-panel" scroll-y enhanced show-scrollbar>
    <!-- 教师/管理员预览提示 -->
    <view class="preview-banner" wx:if="{{isPreview}}">预览模式：可自由体验实验，提交成绩仅对学生开放</view>

    <!-- 实验参数 -->
    <view class="card params-card">
      <view class="panel-title">实验参数</view>

      <picker range="{{problemLabels}}" value="{{problemIndex}}" bindchange="onProblemChange">
        <view class="param-row">
          <text>积分题</text>
          <text class="param-value">{{problemLabels[problemIndex]}} ▾</text>
        </view>
      </picker>

      <view class="param-row">
        <text>区间端点 a</text>
        <input class="num-input" type="digit" value="{{aText}}" bindinput="onAInput" />
      </view>
      <view class="param-row">
        <text>区间端点 b</text>
        <input class="num-input" type="digit" value="{{bText}}" bindinput="onBInput" />
      </view>
      <view class="param-row">
        <text>分段数 n（偶数）</text>
        <input class="num-input" type="number" value="{{nText}}" bindinput="onNInput" bindconfirm="applyParamsInput" />
      </view>
      <view class="param-hint">{{config.n_hint}}；阴影面积随 n 加大贴向 f 曲线下面积</view>
      <view class="btn-row apply-row">
        <button class="btn btn-primary mini-btn" bindtap="applyParamsInput">应用参数（重开节点表）</button>
      </view>

      <view class="param-row">
        <text>被积函数</text>
        <text class="param-value">{{fLabel}}</text>
      </view>
      <view class="param-row">
        <text>步长 h = (b−a)/n</text>
        <text class="param-value">{{hLabel}}</text>
      </view>
    </view>

    <!-- 节点表 -->
    <view class="card table-card">
      <view class="panel-title">分点表（x_i = a + i·h，f(x_i) 为节点函数值）</view>
      <view class="table-row header wide">
        <text>i</text><text>x_i</text><text>f(x_i)</text><text>权重</text>
      </view>
      <view wx:for="{{nodeRows}}" wx:key="i" class="table-row wide">
        <text>{{item.i}}</text><text>{{item.x}}</text><text>{{item.y}}</text><text>{{item.w}}</text>
      </view>
      <view wx:if="{{nodeTableTruncated}}" class="table-row wide ellipsis">
        <text>…</text><text>（共 {{nApplied + 1}} 个分点，已省略中段）</text><text></text><text></text>
      </view>
      <view wx:for="{{nodeRowsTail}}" wx:key="i" class="table-row wide">
        <text>{{item.i}}</text><text>{{item.x}}</text><text>{{item.y}}</text><text>{{item.w}}</text>
      </view>
      <view class="card-note">端点 ×1、奇下标 ×4、偶下标 ×2——复合辛普森的加权结构</view>
    </view>

    <!-- 分步计算 -->
    <view class="card basis-card">
      <view class="panel-title">分步计算（求和与加权留给你）</view>
      <view class="sum-line">S_n = (h/3)·[ f(a) + 4·Σ奇 f(x_i) + 2·Σ偶 f(x_i) + f(b) ]</view>
      <view class="sum-line substituted">h = {{hLabel}}，f(a) = {{fALabel}}，f(b) = {{fBLabel}}</view>
      <view class="card-note">奇下标分点共 {{oddCount}} 个（×4），偶下标分点共 {{evenCount}} 个（×2）。请从分点表自行求出两个和，再代入加权公式算出 S_n——切忌直接抄精确积分值</view>

      <view class="param-row answer-row">
        <text>Σ奇 = f(x₁)+f(x₃)+…</text>
        <input
          class="num-input"
          type="digit"
          value="{{oddSumText}}"
          placeholder="选填（仅审计）"
          bindinput="onOddSumInput"
        />
      </view>
      <view class="param-row answer-row">
        <text>Σ偶 = f(x₂)+f(x₄)+…</text>
        <input
          class="num-input"
          type="digit"
          value="{{evenSumText}}"
          placeholder="选填（仅审计）"
          bindinput="onEvenSumInput"
        />
      </view>
      <view class="card-note">奇/偶和选填：填了将随提交记录进教师端审计日志（不参与打分）</view>
    </view>

    <!-- 最终答案与提交 -->
    <view class="card result-card">
      <view class="panel-title">你的辛普森积分值</view>
      <view class="param-row answer-row">
        <text>S_n =</text>
        <input
          class="num-input"
          type="digit"
          value="{{valueText}}"
          placeholder="填计算结果"
          bindinput="onValueInput"
        />
      </view>
      <view class="card-note">把 h、f(a)、f(b)、Σ奇、Σ偶 代入公式算出 S_n。真值由后端按同一题、区间、n 现算——认真执行公式即满分；抄精确积分（如 sin_pi 的 2）会被截断误差压低分数</view>
      <button wx:if="{{!isPreview}}" class="btn btn-primary submit-btn" bindtap="submitReadings" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交成绩'}}
      </button>
    </view>
  </scroll-view>
</view>

<!-- 全屏图像（点击画布或⛶进入；按钮缩放 / 单指拖动 / 双击复位） -->
<view class="fullscreen-mask" wx:if="{{fullscreen}}">
  <view class="full-bar full-top">
    <text class="full-title">{{fLabel}} · 复合辛普森积分</text>
    <view class="full-btn close" bindtap="exitFullscreen">✕ 关闭</view>
  </view>
  <canvas
    type="2d"
    id="fullCanvas"
    class="full-canvas"
    style="width:{{fullW}}px;height:{{fullCanvasH}}px;"
    bindtouchstart="onPlotTouchStart"
    catchtouchmove="onPlotTouchMove"
    bindtouchend="onPlotTouchEnd"
    bindtouchcancel="onPlotTouchEnd"
  ></canvas>
  <view class="full-bar full-bottom">
    <view class="full-btn" bindtap="zoomBy" data-factor="1.3">＋ 放大</view>
    <view class="full-btn" bindtap="zoomBy" data-factor="0.77">－ 缩小</view>
    <view class="full-btn" bindtap="resetView">⟲ 复位</view>
    <text class="full-tips">拖动可平移 · 双击图像退出</text>
  </view>
</view>
