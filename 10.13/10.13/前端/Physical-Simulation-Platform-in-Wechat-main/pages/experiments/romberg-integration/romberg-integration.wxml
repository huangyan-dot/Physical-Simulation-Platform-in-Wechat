<!-- pages/experiments/romberg-integration/romberg-integration.wxml - 龙贝格积分法（数值分析 L19） -->
<view class="experiment-page">
  <!-- 函数图像区：蓝实线 f(x)、灰线更早层梯形、橙虚线第 k 级梯形、面积阴影、绿虚线 a/b -->
  <view class="canvas-wrap" style="height:{{canvasHeight}}px;">
    <canvas
      type="2d"
      id="plotCanvas"
      class="plot-canvas {{fullscreen ? 'canvas-hidden' : ''}}"
      style="width:{{canvasWidth}}px;height:{{canvasHeight}}px;"
      bindtouchstart="onPlotTouchStart"
      catchtouchmove="onPlotTouchMove"
      bindtouchend="onPlotTouchEnd"
      bindtouchcancel="onPlotTouchEnd"
    ></canvas>
  </view>

  <!-- 图像工具条（放在画布外部，避免被原生 canvas 遮挡） -->
  <view class="graph-toolbar">
    <view class="tool-btn" bindtap="enterFullscreen">⛶ 全屏</view>
    <view class="tool-btn" bindtap="zoomBy" data-factor="1.3">＋</view>
    <view class="tool-btn" bindtap="zoomBy" data-factor="0.77">－</view>
    <view class="tool-btn" bindtap="resetView">⟲</view>
    <text class="tool-hint">折线逐层减半贴近 f，外推再进一步</text>
  </view>

  <scroll-view class="control-panel" scroll-y enhanced show-scrollbar>
    <!-- 教师/管理员预览提示 -->
    <view class="preview-banner" wx:if="{{isPreview}}">预览模式：可自由体验实验，提交成绩仅对学生开放</view>

    <!-- 实验参数 -->
    <view class="card params-card">
      <view class="panel-title">实验参数</view>

      <picker range="{{problemLabels}}" value="{{problemIndex}}" bindchange="onProblemChange">
        <view class="param-row">
          <text>积分题</text>
          <text class="param-value">{{problemLabels[problemIndex]}} ▾</text>
        </view>
      </picker>

      <view class="param-row">
        <text>区间端点 a</text>
        <input class="num-input" type="digit" value="{{aText}}" bindinput="onAInput" />
      </view>
      <view class="param-row">
        <text>区间端点 b</text>
        <input class="num-input" type="digit" value="{{bText}}" bindinput="onBInput" />
      </view>
      <view class="param-row">
        <text>外推深度 k</text>
        <input class="num-input" type="number" value="{{kText}}" bindinput="onKInput" bindconfirm="applyParamsInput" />
      </view>
      <view class="param-hint">{{config.method_hint}}；外推第 1 列 S 即复合辛普森（L17），终值比 S 更准</view>
      <view class="btn-row apply-row">
        <button class="btn btn-primary mini-btn" bindtap="applyParamsInput">应用参数（重开表格）</button>
      </view>

      <view class="param-row">
        <text>被积函数</text>
        <text class="param-value">{{fLabel}}</text>
      </view>
      <view class="param-row">
        <text>末级梯形段数 2^k</text>
        <text class="param-value">{{nKLabel}}</text>
      </view>
    </view>

    <!-- 分点表 -->
    <view class="card table-card">
      <view class="panel-title">分点表（第 k 级分点 x_i = a + i·(b−a)/2^k）</view>
      <view class="table-row header">
        <text>i</text><text>x_i</text><text>f(x_i)</text>
      </view>
      <view wx:for="{{nodeRows}}" wx:key="i" class="table-row">
        <text>{{item.i}}</text><text>{{item.x}}</text><text>{{item.y}}</text>
      </view>
      <view wx:if="{{nodeTableTruncated}}" class="table-row ellipsis">
        <text>…</text><text>（分点过多已省略中段）</text><text></text>
      </view>
      <view wx:for="{{nodeRowsTail}}" wx:key="i" class="table-row">
        <text>{{item.i}}</text><text>{{item.x}}</text><text>{{item.y}}</text>
      </view>
      <view class="card-note">梯形列的每一层只新增上一层分点中间的奇数位节点——表里每个 f(x_i) 只需算一次</view>
    </view>

    <!-- 梯形列（递推 + 选填审计输入） -->
    <view class="card basis-card">
      <view class="panel-title">梯形列 T₀→T_k（求和与递推留给你）</view>
      <view class="card-note">逐次减半：T_m = T_{m−1}/2 + h_m·Σf(新节点)。新节点的函数值全在分点表里，请逐层算出 T₀…T_k</view>

      <view wx:for="{{tRows}}" wx:key="key" class="basis-row">
        <view class="basis-formula">{{item.label}} = {{item.formula}}</view>
        <view class="basis-line"><text class="basis-tag">代入</text><text>{{item.substituted}}</text></view>
        <view class="basis-input-row">
          <text class="basis-input-label">{{item.label}} =</text>
          <input
            class="num-input basis-input"
            type="digit"
            value="{{item.input}}"
            placeholder="选填"
            bindinput="onTColInput"
            data-index="{{index}}"
          />
        </view>
      </view>
      <view class="card-note">T 列选填：填了将随提交记录进教师端审计日志（不参与打分），要么全填要么全空</view>
    </view>

    <!-- 外推三角表 -->
    <view class="card basis-card">
      <view class="panel-title">外推三角表（乘减除留给你）</view>
      <view class="card-note">逐列理查逊外推：第 1 列 S 恰为复合辛普森（sin_pi 默认 k=2 时 S₁=2π/3，正是 L17 的 S₂），第 2 列起更高阶——同一张节点表，精度逐列跃升</view>

      <view wx:for="{{extRows}}" wx:key="key" class="basis-row {{item.isFinal ? 'final-row' : ''}}">
        <view class="basis-formula">{{item.label}} = {{item.formula}}</view>
        <view class="basis-line"><text class="basis-tag">代入</text><text>{{item.substituted}}</text></view>
      </view>
      <view class="card-note">分子是同列相邻两值按 4^j 加权相减（消去误差主项），分母 4^j−1；终值格即三角表右下角</view>
    </view>

    <!-- 最终答案与提交 -->
    <view class="card result-card">
      <view class="panel-title">你的龙贝格终值</view>
      <view class="param-row answer-row">
        <text>终值 =</text>
        <input
          class="num-input"
          type="digit"
          value="{{valueText}}"
          placeholder="填计算结果"
          bindinput="onValueInput"
        />
      </view>
      <view class="card-note">把外推表逐格算到右下角即终值。真值由后端按同一题、区间、k 现算——认真递推即满分；抄精确积分（如 sin_pi 的 2）会因截断误差损失精度分，抄 L17 的 2π/3（漏做第二轮外推）直接不过线</view>
      <button wx:if="{{!isPreview}}" class="btn btn-primary submit-btn" bindtap="submitReadings" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交成绩'}}
      </button>
    </view>
  </scroll-view>
</view>

<!-- 全屏图像（点击画布或⛶进入；按钮缩放 / 单指拖动 / 双击复位） -->
<view class="fullscreen-mask" wx:if="{{fullscreen}}">
  <view class="full-bar full-top">
    <text class="full-title">{{fLabel}} · 龙贝格积分</text>
    <view class="full-btn close" bindtap="exitFullscreen">✕ 关闭</view>
  </view>
  <canvas
    type="2d"
    id="fullCanvas"
    class="full-canvas"
    style="width:{{fullW}}px;height:{{fullCanvasH}}px;"
    bindtouchstart="onPlotTouchStart"
    catchtouchmove="onPlotTouchMove"
    bindtouchend="onPlotTouchEnd"
    bindtouchcancel="onPlotTouchEnd"
  ></canvas>
  <view class="full-bar full-bottom">
    <view class="full-btn" bindtap="zoomBy" data-factor="1.3">＋ 放大</view>
    <view class="full-btn" bindtap="zoomBy" data-factor="0.77">－ 缩小</view>
    <view class="full-btn" bindtap="resetView">⟲ 复位</view>
    <text class="full-tips">拖动可平移 · 双击图像退出</text>
  </view>
</view>
