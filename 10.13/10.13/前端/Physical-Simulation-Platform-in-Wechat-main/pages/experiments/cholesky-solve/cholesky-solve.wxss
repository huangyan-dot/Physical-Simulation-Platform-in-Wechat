/* pages/experiments/cholesky-solve/cholesky-solve.wxss - 平方根法解对称正定方程组（数值分析 L29）
   版式沿用 thomas-solve 页卡片布局；L 因子网格（当前行高亮/主对角强调）为本页特有。 */

.experiment-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

.control-panel {
  flex: 1;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.preview-banner {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(52, 152, 219, 0.08);
  border: 1rpx solid rgba(52, 152, 219, 0.35);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--primary);
}

.params-card,
.step-card,
.result-card {
  margin-bottom: 20rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.param-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--border);
}

.param-row:last-child {
  border-bottom: none;
}

.param-value {
  color: var(--primary);
  font-weight: 500;
}

.param-hint {
  margin: 8rpx 0 12rpx;
  color: var(--text-light);
  font-size: 22rpx;
  line-height: 1.5;
}

/* 原方程组（等宽字体对齐竖式观感） */
.eq-line {
  padding: 8rpx 0;
  font-family: Consolas, Menlo, monospace;
  font-size: 28rpx;
}

/* 矩阵网格（A 阵与 L 因子共用）：行标 + n 列 */
.matrix-row {
  display: flex;
  align-items: stretch;
}

.row-label {
  width: 64rpx;
  flex-shrink: 0;
  color: var(--text-light);
  font-size: 22rpx;
  font-family: Consolas, Menlo, monospace;
  display: flex;
  align-items: center;
}

.matrix-cell {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-family: Consolas, Menlo, monospace;
  font-size: 26rpx;
  border-bottom: 1rpx solid var(--border);
  box-sizing: border-box;
}

.matrix-row:last-child .matrix-cell {
  border-bottom: none;
}

/* 零元素/未长出置灰（'·'）——L 上三角与待分解区的直观展示 */
.matrix-cell.cell-zero {
  color: var(--text-light);
  opacity: 0.45;
}

/* L 主对角恒正——强调色 */
.matrix-cell.cell-diag {
  color: var(--primary);
  font-weight: 600;
}

/* L 网格当前分解行高亮 */
.matrix-row.row-active .matrix-cell {
  background: rgba(52, 152, 219, 0.12);
  color: var(--primary);
  font-weight: 600;
}

/* 分解/前代/回代公式行 */
.back-line {
  padding: 12rpx 0;
  font-family: Consolas, Menlo, monospace;
  font-size: 24rpx;
  border-bottom: 1rpx solid var(--border);
  line-height: 1.6;
}

.back-line:last-of-type {
  border-bottom: none;
}

.empty-iter {
  padding: 24rpx 0;
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
}

/* 解向量/审计输入行 */
.sol-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.sol-row:last-of-type {
  border-bottom: none;
}

.sol-label {
  width: 96rpx;
  flex-shrink: 0;
  font-family: Consolas, Menlo, monospace;
  font-size: 28rpx;
}

.num-input {
  flex: 1;
  text-align: right;
  color: var(--primary);
  font-weight: 500;
  font-family: Consolas, Menlo, monospace;
}

/* 审计区小标题 */
.audit-title {
  margin-top: 20rpx;
  margin-bottom: 4rpx;
}

.kv-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: var(--text-light);
}

.kv-row text:last-child {
  color: var(--text);
  font-weight: 500;
  font-family: Consolas, Menlo, monospace;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.half-btn {
  flex: 1;
  font-size: 26rpx;
  height: 80rpx;
}

.mini-btn {
  flex: 1;
  font-size: 26rpx;
  height: 76rpx;
}

.root-value {
  color: var(--success);
  font-weight: 600;
}

.submit-btn {
  margin-top: 16rpx;
}

/* 顶部固定图像区（直接作用于自定义组件宿主节点；不随 control-panel 滚动） */
.iter-graph {
  display: block;
  width: 100%;
  flex-shrink: 0;
}
