<!-- pages/assignment/list/list.wxml -->
<view class="container">

  <!-- 学生视角：我的作业 -->
  <block wx:if="{{role === 'student'}}">
    <view class="section-title">我的作业</view>

    <view wx:if="{{loading}}" class="loading-state">
      <text>加载中...</text>
    </view>

    <view wx:elif="{{loadError}}" class="empty-state">
      <text class="empty-icon">⚠️</text>
      <text>{{loadError}}</text>
      <button class="retry-btn" size="mini" bindtap="onRetry">重试</button>
    </view>

    <view wx:elif="{{assignments.length === 0}}" class="empty-state">
      <text class="empty-icon">📝</text>
      <text>暂无作业</text>
    </view>

    <view wx:else>
      <view wx:for="{{assignments}}" wx:key="id" class="asg-card card">
        <view class="asg-header">
          <text class="asg-title">{{item.title}}</text>
          <text class="asg-status {{item.overdue ? 'overdue' : (item.submitted ? 'submitted' : 'pending')}}">
            {{item.overdue ? '已截止' : (item.submitted ? '已提交' : '待完成')}}
          </text>
        </view>
        <view class="asg-meta">
          <text>实验：{{item.level_name}}</text>
          <text>截止：{{item.deadline}}</text>
        </view>
        <view class="asg-meta">
          <text>计分：测量数据 {{item.data_weight}}% ：自测 {{100 - item.data_weight}}%</text>
        </view>
        <view wx:if="{{item.submitted}}" class="asg-score">
          综合最高分 {{item.best_score}}
          （数据 {{item.best_data_score}} / 自测 {{item.quiz_done ? item.best_quiz_score : '未做'}}）
          · 尝试 {{item.attempts}} 次
        </view>
        <view wx:if="{{item.submitted && !item.quiz_done && !item.overdue}}" class="asg-warn">
          还没做自测题目，完成后综合得分会提高
        </view>
        <button
          class="btn btn-primary"
          size="mini"
          bindtap="goExperiment"
          data-id="{{item.id}}"
          data-level-id="{{item.level_id}}"
          data-code="{{item.experiment_code}}"
          data-overdue="{{item.overdue}}"
        >
          {{item.submitted ? '再次尝试' : '开始做'}}
        </button>
      </view>
    </view>
  </block>

  <!-- 教师视角：作业管理 -->
  <block wx:if="{{role === 'teacher' || role === 'admin'}}">
    <view class="card">
      <view class="section-title">作业管理</view>
      <view wx:if="{{classes.length > 0}}" class="form-item">
        <picker bindchange="onClassChange" value="{{classIndex}}" range="{{classes}}" range-key="name">
          <view class="picker {{selectedClassId ? '' : 'placeholder'}}">
            {{selectedClassId ? classes[classIndex].name : '请选择班级'}}
          </view>
        </picker>
      </view>
      <view wx:else class="empty-state" style="padding: 40rpx 0;">
        <text>请先创建班级</text>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading-state">
      <text>加载中...</text>
    </view>

    <view wx:elif="{{loadError}}" class="empty-state">
      <text class="empty-icon">⚠️</text>
      <text>{{loadError}}</text>
      <button class="retry-btn" size="mini" bindtap="onRetry">重试</button>
    </view>

    <view wx:elif="{{classAssignments.length === 0 && selectedClassId}}" class="empty-state">
      <text class="empty-icon">📝</text>
      <text>该班暂无作业</text>
    </view>

    <view wx:else>
      <view wx:for="{{classAssignments}}" wx:key="id" class="asg-card card">
        <view class="asg-header">
          <text class="asg-title">{{item.title}}</text>
        </view>
        <view class="asg-meta">
          <text>实验：{{item.level_name}}</text>
          <text>截止：{{item.deadline}}</text>
        </view>
        <view class="asg-meta">
          <text>计分：测量数据 {{item.data_weight}}% ：自测 {{100 - item.data_weight}}%</text>
        </view>
        <view class="asg-actions">
          <button class="btn btn-primary" size="mini" bindtap="goSubmissions" data-id="{{item.id}}" data-title="{{item.title}}">
            查看提交
          </button>
          <button class="btn btn-outline danger" size="mini" bindtap="deleteAssignment" data-id="{{item.id}}">
            删除
          </button>
        </view>
      </view>
    </view>
  </block>

</view>
