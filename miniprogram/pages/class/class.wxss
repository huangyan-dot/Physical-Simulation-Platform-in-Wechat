/* pages/class/class.wxss */

.create-card {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.class-list {
  padding-bottom: 40rpx;
}

.class-card {
  margin-bottom: 20rpx;
}

.class-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.class-name {
  font-size: 32rpx;
  font-weight: 600;
}

.class-teacher {
  font-size: 24rpx;
  color: var(--text-light);
}

.class-stats {
  font-size: 26rpx;
  color: var(--text-light);
  margin-bottom: 16rpx;
}

.class-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.action-btn {
  margin: 0;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.modal-actions .btn {
  flex: 1;
}

/* 班级码标签 */
.class-code-tag {
  font-size: 24rpx;
  color: #3498db;
  background: #ebf5fb;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* 成员列表弹窗 */
.member-list {
  max-height: 600rpx;
}

.member-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.member-info {
  display: flex;
  flex-direction: column;
}

.member-name {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
}

.member-no {
  font-size: 24rpx;
  color: #95a5a6;
}

.member-joined {
  font-size: 22rpx;
  color: #bdc3c7;
}
