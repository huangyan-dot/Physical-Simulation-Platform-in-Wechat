<!-- pages/experiments/photoelectric/photoelectric.wxml -->
<view class="experiment-page">
  <view class="canvas-wrap">
    <canvas type="2d" id="peCanvas" class="pe-canvas"></canvas>
    <view class="canvas-hint">V_s = (h/e)ν − W/e</view>
  </view>

  <scroll-view class="control-panel" scroll-y enhanced show-scrollbar>
    <view class="card params-card">
      <view class="panel-title">实验参数</view>
      <view class="param-item">
        <view class="param-label">
          <text>滤光片波长</text>
          <text class="param-value">{{config.wavelength_nm}} nm</text>
        </view>
        <slider min="200" max="700" step="1" value="{{config.wavelength_nm}}"
          bindchange="onWavelengthChange" bindchanging="onWavelengthChange" show-value />
      </view>
      <view class="calc-row">
        <text class="calc-label">光频率 ν：</text>
        <text class="calc-value">{{freqStr}} ×10¹⁴ Hz</text>
      </view>
      <view class="calc-row">
        <text class="calc-label">理论遏止电压：</text>
        <text class="calc-value">{{stopVStr}} V</text>
      </view>
    </view>

    <view class="card readings-card">
      <view class="panel-title">遏止电压记录</view>
      <view class="reading-row header">
        <text>波长(nm)</text>
        <text>频率(Hz)</text>
        <text>遏止电压(V)</text>
      </view>
      <view wx:for="{{readings}}" wx:key="wavelength_nm" class="reading-row">
        <text>{{item.wavelength_nm}}</text>
        <text>{{item.freq_str}}</text>
        <input class="reading-input" type="digit" value="{{item.stop_v}}"
          data-index="{{index}}" bindinput="onReadingInput" />
      </view>
      <button class="btn btn-primary submit-btn" bindtap="submitReadings" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交读数'}}
      </button>
    </view>
  </scroll-view>
</view>
