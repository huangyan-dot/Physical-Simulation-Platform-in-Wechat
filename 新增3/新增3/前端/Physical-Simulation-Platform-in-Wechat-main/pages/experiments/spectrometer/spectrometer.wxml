<!-- pages/experiments/spectrometer/spectrometer.wxml -->
<view class="experiment-page">
  <view class="canvas-wrap">
    <canvas type="2d" id="spCanvas" class="sp-canvas"></canvas>
    <view class="canvas-hint">n = sin((A+δ)/2) / sin(A/2)，最小偏向角法</view>
  </view>
  <scroll-view class="control-panel" scroll-y enhanced show-scrollbar>
    <view class="card params-card">
      <view class="panel-title">实验参数</view>
      <view class="param-item">
        <view class="param-label">
          <text>棱镜顶角 A</text>
          <text class="param-value">{{prismAngle}}°</text>
        </view>
        <slider min="45" max="70" step="1" value="{{prismAngle}}"
          bindchange="onAngleChange" bindchanging="onAngleChange" show-value />
      </view>
      <view class="calc-row">
        <text class="calc-label">棱镜顶角 A：</text>
        <text class="calc-value">{{prismAngle}}°</text>
      </view>
      <view class="calc-row">
        <text class="calc-label">理论折射率 n：</text>
        <text class="calc-value">{{nTheoretical}}</text>
      </view>
      <view class="calc-row">
        <text class="calc-label">理论最小偏向角 δ：</text>
        <text class="calc-value">{{deltaTheoretical}}°</text>
      </view>
    </view>
    <view class="card readings-card">
      <view class="panel-title">最小偏向角测量记录</view>
      <view class="reading-row header">
        <text>组号</text>
        <text>最小偏向角 δ (°)</text>
      </view>
      <view wx:for="{{readings}}" wx:key="set_num" class="reading-row">
        <text>{{item.set_num}}</text>
        <input class="reading-input" type="digit" value="{{item.min_deviation_deg}}"
          data-index="{{index}}" bindinput="onReadingInput" />
      </view>
      <button class="btn btn-primary submit-btn" bindtap="submitReadings" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交读数'}}
      </button>
    </view>
  </scroll-view>
</view>
