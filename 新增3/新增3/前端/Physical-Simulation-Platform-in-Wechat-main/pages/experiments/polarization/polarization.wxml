<!-- pages/experiments/polarization/polarization.wxml -->
<view class="experiment-page">
  <view class="canvas-wrap">
    <canvas type="2d" id="polCanvas" class="pol-canvas"></canvas>
    <view class="canvas-hint">I = I₀cos²(θ) 马吕斯定律</view>
  </view>
  <scroll-view class="control-panel" scroll-y enhanced show-scrollbar>
    <view class="card params-card">
      <view class="panel-title">实验参数</view>
      <view class="param-item">
        <view class="param-label">
          <text>检偏器角度 θ</text>
          <text class="param-value">{{analyzerAngle}}°</text>
        </view>
        <slider min="0" max="90" step="1" value="{{analyzerAngle}}"
          bindchange="onAngleChange" bindchanging="onAngleChange" show-value />
      </view>
      <view class="calc-row">
        <text class="calc-label">理论透射光强：</text>
        <text class="calc-value">{{theoryIntensityStr}}</text>
      </view>
      <view class="calc-row">
        <text class="calc-label">实测透射光强：</text>
        <text class="calc-value">{{measuredIntensityStr}}</text>
      </view>
    </view>
    <view class="card readings-card">
      <view class="panel-title">光强-角度记录</view>
      <view class="reading-row header">
        <text>角度(°)</text>
        <text>理论光强</text>
        <text>实测光强</text>
      </view>
      <view wx:for="{{readings}}" wx:key="angle" class="reading-row">
        <text>{{item.angle}}</text>
        <text>{{item.theory}}</text>
        <input class="reading-input" type="digit" value="{{item.measured}}"
          data-index="{{index}}" bindinput="onReadingInput" />
      </view>
      <button class="btn btn-primary submit-btn" bindtap="submitReadings" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交读数'}}
      </button>
    </view>
  </scroll-view>
</view>
