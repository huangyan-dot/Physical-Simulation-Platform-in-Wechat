<!-- pages/experiments/oscilloscope/oscilloscope.wxml -->
<view class="experiment-page">
  <!-- 3D 面板区域（当前为 2D 波形演示，接入 three.js-miniprogram 后可替换为 WebGL） -->
  <view class="canvas-wrap">
    <canvas
      type="2d"
      id="scopeCanvas"
      class="scope-canvas"
    ></canvas>

    <view class="screen-label">CH1 / CH2 波形</view>
  </view>

  <scroll-view class="control-panel" scroll-y enhanced show-scrollbar
    >
    <view class="card params-card">
      <view class="panel-title">示波器参数</view>

      <view class="param-row">
        <view class="param-item half">
          <text class="param-label">CH1 频率 f₁ (Hz)</text>
          <input
            class="param-input"
            type="digit"
            value="{{ch1.f}}"
            data-ch="ch1"
            data-field="f"
            bindinput="onParamInput"
          />
        </view>

        <view class="param-item half">
          <text class="param-label">CH1 振幅 A₁ (V)</text>
          <input
            class="param-input"
            type="digit"
            value="{{ch1.A}}"
            data-ch="ch1"
            data-field="A"
            bindinput="onParamInput"
          />
        </view>
      </view>

      <view class="param-row">
        <view class="param-item half">
          <text class="param-label">CH2 频率 f₂ (Hz)</text>
          <input
            class="param-input"
            type="digit"
            value="{{ch2.f}}"
            data-ch="ch2"
            data-field="f"
            bindinput="onParamInput"
          />
        </view>

        <view class="param-item half">
          <text class="param-label">CH2 振幅 A₂ (V)</text>
          <input
            class="param-input"
            type="digit"
            value="{{ch2.A}}"
            data-ch="ch2"
            data-field="A"
            bindinput="onParamInput"
          />
        </view>
      </view>

      <view class="param-item">
        <text class="param-label">显示模式</text>
        <view class="mode-tabs">
          <view
            wx:for="{{modes}}"
            wx:key="*this"
            class="mode-tab {{mode === item ? 'active' : ''}}"
            bindtap="onModeChange"
            data-mode="{{item}}"
          >
            {{item}}
          </view>
        </view>
      </view>

      <view class="formula-hint">
        y = A·sin(2πft + φ)
      </view>
    </view>

    <view class="card">
      <view class="panel-title">读数记录</view>
      <view class="reading-row header">
        <text>通道</text>
        <text>频率(Hz)</text>
        <text>振幅(V)</text>
      </view>
      <view class="reading-row">
        <text>CH1</text>
        <input class="reading-input" type="digit" value="{{readings.ch1_f}}" data-field="ch1_f" bindinput="onReadingInput" />
        <input class="reading-input" type="digit" value="{{readings.ch1_A}}" data-field="ch1_A" bindinput="onReadingInput" />
      </view>
      <view class="reading-row">
        <text>CH2</text>
        <input class="reading-input" type="digit" value="{{readings.ch2_f}}" data-field="ch2_f" bindinput="onReadingInput" />
        <input class="reading-input" type="digit" value="{{readings.ch2_A}}" data-field="ch2_A" bindinput="onReadingInput" />
      </view>

      <button class="btn btn-primary submit-btn" bindtap="submitReadings" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交读数'}}
      </button>
    </view>
  </scroll-view>
</view>
