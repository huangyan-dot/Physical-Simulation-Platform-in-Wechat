<!-- pages/experiments/diffraction-grating/diffraction-grating.wxml -->
<view class="experiment-page">
  <view class="canvas-wrap">
    <canvas type="2d" id="dgCanvas" class="dg-canvas"></canvas>
    <view class="canvas-hint">d·sin(θ) = k·λ</view>
  </view>

  <scroll-view class="control-panel" scroll-y enhanced show-scrollbar>
    <view class="card params-card">
      <view class="panel-title">实验参数</view>
      <view class="param-item">
        <view class="param-label">
          <text>光栅常数 d</text>
          <text class="param-value">{{gratingLines}} 线/mm</text>
        </view>
        <slider min="100" max="1200" step="50" value="{{gratingLines}}"
          bindchange="onGratingChange" bindchanging="onGratingChange" show-value />
      </view>
      <view class="calc-row">
        <text class="calc-label">d =</text>
        <text class="calc-value">{{gratingConstStr}} μm</text>
      </view>
      <view class="calc-row">
        <text class="calc-label">光源：</text>
        <text class="calc-value">钠光 589.3 nm</text>
      </view>
    </view>

    <view class="card readings-card">
      <view class="panel-title">衍射角记录</view>
      <view class="reading-row header">
        <text>级次 k</text>
        <text>衍射角 θ(°)</text>
        <text>sin(θ)</text>
      </view>
      <view wx:for="{{readings}}" wx:key="order" class="reading-row">
        <text>{{item.order > 0 ? '+' : ''}}{{item.order}}</text>
        <input class="reading-input" type="digit" value="{{item.angle_deg}}"
          data-index="{{index}}" bindinput="onAngleInput" />
        <text>{{item.sin_theta}}</text>
      </view>
      <button class="btn btn-primary submit-btn" bindtap="submitReadings" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交读数'}}
      </button>
    </view>
  </scroll-view>
</view>
