/* pages/experiments/pendulum/pendulum.wxss */

.experiment-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6fa;
}

.canvas-wrap {
  position: relative;
  flex-shrink: 0;
  background: #fff;
}

.pendulum-canvas {
  display: block;
  width: 100%;
}

.canvas-hint {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  color: rgba(0, 0, 0, 0.4);
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.8);
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.control-panel {
  flex: 1;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.params-card {
  margin-bottom: 20rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.param-item {
  margin-bottom: 24rpx;
}

.param-label {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}

.param-value {
  color: var(--primary);
  font-weight: 500;
}

.calc-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--border);
}

.calc-label {
  font-size: 28rpx;
  color: var(--text);
}

.calc-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary);
  margin-left: 16rpx;
}

.reading-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
  font-size: 26rpx;
}

.reading-row.header {
  font-weight: 600;
  color: var(--text-light);
  border-bottom: 2rpx solid var(--border);
}

.reading-row text,
.reading-row input {
  flex: 1;
  text-align: center;
}

.reading-input {
  height: 56rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.submit-btn {
  margin-top: 32rpx;
  width: 100%;
}