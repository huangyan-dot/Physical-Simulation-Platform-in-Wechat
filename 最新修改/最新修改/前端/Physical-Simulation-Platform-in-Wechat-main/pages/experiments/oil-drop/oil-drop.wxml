<!-- pages/experiments/oil-drop/oil-drop.wxml -->
<view class="experiment-page">
  <view class="canvas-wrap">
    <canvas type="2d" id="odCanvas" class="od-canvas"></canvas>
    <view class="canvas-hint">q = (6πηrv·d) / V</view>
  </view>
  <scroll-view class="control-panel" scroll-y enhanced show-scrollbar>
    <view class="card params-card">
      <view class="panel-title">实验参数</view>
      <view class="param-item">
        <view class="param-label">
          <text>平衡电压 V</text>
          <text class="param-value">{{voltage}} V</text>
        </view>
        <slider min="100" max="500" step="1" value="{{voltage}}"
          bindchange="onVoltageChange" bindchanging="onVoltageChange" show-value />
      </view>
      <view class="calc-row">
        <text class="calc-label">油滴带电量：</text>
        <text class="calc-value">{{chargeStr}} ×10⁻¹⁹ C</text>
      </view>
      <view class="calc-row">
        <text class="calc-label">元电荷数 n：</text>
        <text class="calc-value">{{nValue}}</text>
      </view>
    </view>
    <view class="card readings-card">
      <view class="panel-title">油滴数据记录</view>
      <view class="reading-row header">
        <text>序号</text>
        <text>电压(V)</text>
        <text>下落距离(mm)</text>
        <text>时间(s)</text>
      </view>
      <view wx:for="{{readings}}" wx:key="idx" class="reading-row">
        <text>{{item.idx}}</text>
        <input class="reading-input" type="digit" value="{{item.voltage}}" data-index="{{index}}" data-field="voltage" bindinput="onInput" />
        <input class="reading-input" type="digit" value="{{item.distance}}" data-index="{{index}}" data-field="distance" bindinput="onInput" />
        <input class="reading-input" type="digit" value="{{item.time}}" data-index="{{index}}" data-field="time" bindinput="onInput" />
      </view>
      <button class="btn btn-primary submit-btn" bindtap="submitReadings" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交读数'}}
      </button>
    </view>
  </scroll-view>
</view>
