<!-- pages/experiments/falling-ball/falling-ball.wxml -->
<view class="experiment-page">
  <view class="canvas-wrap">
    <canvas type="2d" id="fbCanvas" class="fb-canvas"></canvas>
    <view class="canvas-hint">η = (2/9)·r²·(ρ-ρ₀)·g / v，斯托克斯定律</view>
  </view>
  <scroll-view class="control-panel" scroll-y enhanced show-scrollbar>
    <view class="card params-card">
      <view class="panel-title">实验参数</view>
      <view class="param-item">
        <view class="param-label">
          <text>小球密度 ρ</text>
          <text class="param-value">{{ballDensity}} kg/m³</text>
        </view>
        <slider min="7000" max="8500" step="50" value="{{ballDensity}}"
          bindchange="onDensityChange" bindchanging="onDensityChange" show-value />
      </view>
      <view class="calc-row">
        <text class="calc-label">液体密度 ρ₀：</text>
        <text class="calc-value">960 kg/m³</text>
      </view>
      <view class="calc-row">
        <text class="calc-label">理论粘滞系数 η：</text>
        <text class="calc-value">0.985 Pa·s</text>
      </view>
    </view>
    <view class="card readings-card">
      <view class="panel-title">落球测量数据</view>
      <view class="reading-row header">
        <text>组号</text>
        <text>直径(mm)</text>
        <text>距离(m)</text>
        <text>时间(s)</text>
      </view>
      <view wx:for="{{readings}}" wx:key="set_num" class="reading-row">
        <text>{{item.set_num}}</text>
        <input class="reading-input" type="digit" value="{{item.ball_diameter_mm}}"
          data-index="{{index}}" data-field="ball_diameter_mm" bindinput="onReadingInput" />
        <input class="reading-input" type="digit" value="{{item.distance_m}}"
          data-index="{{index}}" data-field="distance_m" bindinput="onReadingInput" />
        <input class="reading-input" type="digit" value="{{item.time_s}}"
          data-index="{{index}}" data-field="time_s" bindinput="onReadingInput" />
      </view>
      <button class="btn btn-primary submit-btn" bindtap="submitReadings" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交读数'}}
      </button>
    </view>
  </scroll-view>
</view>
