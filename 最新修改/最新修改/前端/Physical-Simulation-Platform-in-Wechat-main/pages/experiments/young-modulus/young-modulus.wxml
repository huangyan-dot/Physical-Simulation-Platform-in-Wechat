<!-- pages/experiments/young-modulus/young-modulus.wxml -->
<view class="experiment-page">
  <!-- 画布区 -->
  <view class="canvas-wrap">
    <canvas
      type="2d"
      id="ymCanvas"
      class="ym-canvas"
    ></canvas>
    <view class="canvas-hint">E = 8FLD / (πd²b·Δn)</view>
  </view>

  <scroll-view class="control-panel" scroll-y enhanced show-scrollbar>
    <!-- 参数控制 -->
    <view class="card params-card">
      <view class="panel-title">实验参数</view>

      <view class="param-item">
        <view class="param-label">
          <text>砝码质量 m</text>
          <text class="param-value">{{config.mass_kg}} kg</text>
        </view>
        <slider
          min="0.1"
          max="2.0"
          step="0.1"
          value="{{config.mass_kg}}"
          bindchange="onMassChange"
          bindchanging="onMassChange"
          show-value
        />
      </view>

      <view class="param-item">
        <view class="param-label">
          <text>金属丝直径 d</text>
          <text class="param-value">{{config.diameter_mm}} mm</text>
        </view>
        <slider
          min="0.2"
          max="1.0"
          step="0.05"
          value="{{config.diameter_mm}}"
          bindchange="onDiameterChange"
          bindchanging="onDiameterChange"
          show-value
        />
      </view>

      <view class="param-item">
        <view class="param-label">
          <text>光杠杆臂长 b</text>
          <text class="param-value">{{config.lever_arm_mm}} mm</text>
        </view>
        <slider
          min="40"
          max="100"
          step="5"
          value="{{config.lever_arm_mm}}"
          bindchange="onLeverArmChange"
          bindchanging="onLeverArmChange"
          show-value
        />
      </view>

      <view class="param-item">
        <view class="param-label">
          <text>镜尺距离 D</text>
          <text class="param-value">{{config.mirror_dist_m}} m</text>
        </view>
        <slider
          min="0.5"
          max="3.0"
          step="0.1"
          value="{{config.mirror_dist_m}}"
          bindchange="onMirrorDistChange"
          bindchanging="onMirrorDistChange"
          show-value
        />
      </view>

      <view class="calc-row">
        <text class="calc-label">理论杨氏模量：</text>
        <text class="calc-value">{{youngModulusStr}} Pa</text>
      </view>
    </view>

    <!-- 读数表 -->
    <view class="card readings-card">
      <view class="panel-title">望远镜读数记录</view>

      <view class="reading-row header">
        <text>砝码数</text>
        <text>加荷读数(mm)</text>
        <text>减荷读数(mm)</text>
      </view>

      <view
        wx:for="{{readings}}"
        wx:key="load"
        class="reading-row"
      >
        <text>{{item.load}}</text>
        <input
          class="reading-input"
          type="digit"
          value="{{item.reading}}"
          data-index="{{index}}"
          bindinput="onReadingInput"
        />
        <text>{{item.descending}}</text>
      </view>

      <button class="btn btn-primary submit-btn" bindtap="submitReadings" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交读数'}}
      </button>
    </view>
  </scroll-view>
</view>
