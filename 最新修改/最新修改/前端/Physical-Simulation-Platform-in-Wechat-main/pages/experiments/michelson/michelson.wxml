<!-- pages/experiments/michelson/michelson.wxml -->
<view class="experiment-page">
  <!-- 画布区 -->
  <view class="canvas-wrap">
    <canvas
      type="2d"
      id="michCanvas"
      class="mich-canvas"
    ></canvas>
    <view class="canvas-hint">λ = 2d / N</view>
  </view>

  <scroll-view class="control-panel" scroll-y enhanced show-scrollbar>
    <!-- 参数控制 -->
    <view class="card params-card">
      <view class="panel-title">实验参数</view>

      <view class="param-item">
        <view class="param-label">
          <text>光源波长 λ</text>
          <text class="param-value">{{config.wavelength_nm}} nm</text>
        </view>
        <slider
          min="400"
          max="700"
          step="0.1"
          value="{{config.wavelength_nm}}"
          bindchange="onWavelengthChange"
          bindchanging="onWavelengthChange"
          show-value
        />
      </view>

      <view class="param-item">
        <view class="param-label">
          <text>反射镜移动距离 d</text>
          <text class="param-value">{{mirrorDistUM}} μm</text>
        </view>
        <slider
          min="5"
          max="100"
          step="0.5"
          value="{{mirrorDistUM}}"
          bindchange="onMirrorDistChange"
          bindchanging="onMirrorDistChange"
          show-value
        />
      </view>

      <view class="calc-row">
        <text class="calc-label">理论条纹数 N：</text>
        <text class="calc-value">{{fringeCount}}</text>
      </view>
    </view>

    <!-- 读数表 -->
    <view class="card readings-card">
      <view class="panel-title">条纹计数记录</view>

      <view class="reading-row header">
        <text>序号</text>
        <text>条纹数 N</text>
        <text>镜移 d(μm)</text>
      </view>

      <view
        wx:for="{{readings}}"
        wx:key="idx"
        class="reading-row"
      >
        <text>{{item.idx}}</text>
        <input
          class="reading-input"
          type="number"
          value="{{item.n}}"
          data-index="{{index}}"
          bindinput="onNInput"
        />
        <input
          class="reading-input"
          type="digit"
          value="{{item.mirror_um}}"
          data-index="{{index}}"
          bindinput="onMirrorInput"
        />
      </view>

      <button class="btn btn-primary submit-btn" bindtap="submitReadings" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交读数'}}
      </button>
    </view>
  </scroll-view>
</view>
