<!-- pages/experiments/pn-junction/pn-junction.wxml -->
<view class="experiment-page">
  <view class="canvas-wrap">
    <canvas type="2d" id="pnCanvas" class="pn-canvas"></canvas>
    <view class="canvas-hint">I = I₀·exp(eV/kT)，ln(I)-V 线性回归求 k</view>
  </view>
  <scroll-view class="control-panel" scroll-y enhanced show-scrollbar>
    <view class="card params-card">
      <view class="panel-title">实验参数</view>
      <view class="calc-row">
        <text class="calc-label">环境温度 T：</text>
        <text class="calc-value">300 K</text>
      </view>
      <view class="calc-row">
        <text class="calc-label">理想因子 n：</text>
        <text class="calc-value">1.0</text>
      </view>
      <view class="calc-row">
        <text class="calc-label">理论玻尔兹曼常数 k：</text>
        <text class="calc-value">1.381×10⁻²³ J/K</text>
      </view>
    </view>
    <view class="card readings-card">
      <view class="panel-title">I-V 特性测量数据</view>
      <view class="reading-row header">
        <text>组号</text>
        <text>电压 V (V)</text>
        <text>电流 I (µA)</text>
      </view>
      <view wx:for="{{readings}}" wx:key="set_num" class="reading-row">
        <text>{{item.set_num}}</text>
        <input class="reading-input" type="digit" value="{{item.voltage_v}}"
          data-index="{{index}}" data-field="voltage_v" bindinput="onReadingInput" />
        <input class="reading-input" type="digit" value="{{item.current_ua}}"
          data-index="{{index}}" data-field="current_ua" bindinput="onReadingInput" />
      </view>
      <button class="btn btn-primary submit-btn" bindtap="submitReadings" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交读数'}}
      </button>
    </view>
  </scroll-view>
</view>
