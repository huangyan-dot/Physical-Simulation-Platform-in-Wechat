<!-- pages/login/login.wxml -->
<view class="container login-container">
  <view class="login-header">
    <view class="logo">🧮</view>
    <view class="title">数值分析实验 3D 模拟</view>
    <view class="subtitle">大学生数值分析实验虚拟仿真平台</view>
  </view>

  <!-- 微信登录 -->
  <view wx:if="{{mode === 'login'}}" class="login-body">
    <button
      class="btn btn-primary login-btn"
      bindtap="handleLogin"
      disabled="{{loading}}"
    >
      {{loading ? '登录中...' : '微信一键登录'}}
    </button>
    <view class="tips">
      <text>登录即代表同意《用户协议》和《隐私政策》</text>
    </view>

    <!-- 开发者登录入口（dev 后门，上线前删除此 block） -->
    <view class="dev-area">
      <view class="mock-divider">
        <text class="mock-divider-text">-- 开发者登录（接后端） --</text>
      </view>
      <view class="dev-btns">
        <button class="dev-btn dev-student" bindtap="handleDevLogin" data-role="student" disabled="{{loading}}">学生</button>
        <button class="dev-btn dev-teacher" bindtap="handleDevLogin" data-role="teacher" disabled="{{loading}}">教师</button>
        <button class="dev-btn dev-admin" bindtap="handleDevLogin" data-role="admin" disabled="{{loading}}">管理员</button>
      </view>
    </view>
  </view>

  <!-- 补全信息 -->
  <view wx:if="{{mode === 'complete'}}" class="complete-body card">
    <view class="form-title">补全学籍信息</view>
    <view class="form-item">
      <text class="label">姓名</text>
      <input
        class="input"
        placeholder="请输入真实姓名"
        value="{{form.name}}"
        bindinput="onInput"
        data-field="name"
      />
    </view>

    <view class="form-item">
      <text class="label">学号</text>
      <input
        class="input"
        placeholder="请输入学号"
        value="{{form.student_no}}"
        bindinput="onInput"
        data-field="student_no"
      />
    </view>

    <view class="form-item">
      <text class="label">班级</text>
      <picker bindchange="onClassChange" value="{{classIndex}}" range="{{classList}}" range-key="name">
        <view class="picker {{form.class_id ? '' : 'placeholder'}}">
          {{form.class_id ? classList[classIndex].name : '请选择班级'}}
        </view>
      </picker>
    </view>

    <button
      class="btn btn-primary submit-btn"
      bindtap="handleComplete"
      disabled="{{loading}}"
    >
      {{loading ? '保存中...' : '保存并进入'}}
    </button>
  </view>
</view>
